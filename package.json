{
  "name": "nid-giga-archive",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "check": "node scripts/check.mjs",
    "test": "node --import tsx --test tests/*.test.mjs",
    "validate": "node scripts/validate-archive.mjs",
    "benchmark": "node scripts/search-benchmark.mjs",
    "prestart": "npm run validate",
    "predev": "npm run validate",
    "build": "node scripts/build.mjs",
    "assets:fetch": "node scripts/fetch-downloads.mjs",
    "preview": "node server.mjs"
  },
