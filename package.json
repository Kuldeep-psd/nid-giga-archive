    "node": ">=22.22.2 <23"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.0",
    "tsx": "4.23.15",
    "vite": "8.3.0"
  }
}
